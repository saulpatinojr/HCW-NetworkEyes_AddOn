# Network Assessment lab edition: every environment variable, no secret values.
# Copy to .env for local development; the lab host renders these from the website repository's
# Ansible role (public values in group_vars, secrets in the host vault as vault_addon_network_assessment_<name>).

# Listening port inside the container (the lab host publishes 127.0.0.1:18082 -> 8080).
PORT=8080

# Exact origins allowed by CORS, space-separated. Empty in production: the pane is same-origin with its API.
NA_ALLOWED_ORIGINS=

# Content-Security-Policy frame-ancestors. Default 'none' (also sends X-Frame-Options: DENY).
# The lab host sets the two site origins; the value must equal the host's caddy_frame_ancestors.
NA_FRAME_ANCESTORS='none'

# Site origins the pane may post hcw-addon messages to, space-separated (served by /api/health as siteOrigins).
NA_SITE_ORIGINS=

# Human-verification secret (vault key vault_addon_network_assessment_turnstile_secret). Never commit a value.
TURNSTILE_SECRET=

# Human-verification public site key, published by /api/health.
NA_TURNSTILE_SITE_KEY=

# Public hostname the human-verification token must be bound to (empty: hostname is not checked, local only).
NA_PUBLIC_HOST=

# Public base URL of the lab API (passed to guided workspace containers so they can redeem x-bundle-token).
NA_PUBLIC_BASE_URL=https://network-assessment.lab.hybridcloudworks.com

# Always-on guided workspace handoff (ADR-0005). CODER_SESSION_TOKEN is optional (leave empty for browser-session deep links).
CODER_URL=https://coder.lab.hybridcloudworks.com
CODER_SESSION_TOKEN=
CODER_TEMPLATE_ID=na-guided-lab
NA_WORKSPACE_TTL_MINUTES=240

# Local development and e2e only: allow uploads without human verification (logged as a warning at startup).
NA_ALLOW_NO_TURNSTILE=0

# Assessment lifetime and store capacity.
NA_TTL_MINUTES=120
NA_MAX_ITEMS=200

# Rate limit on uploads per client address, and the concurrency bound on evaluation.
NA_RATE_LIMIT_POSTS=10
NA_RATE_LIMIT_WINDOW_MINUTES=10
NA_MAX_CONCURRENT=2

# 1 when the first X-Forwarded-For value is the client address (only behind the lab host's reverse proxy).
NA_TRUST_PROXY=0

# 1 silences the JSON log lines on stderr (tests).
NA_LOG_SILENT=0

# Override the static pane directory and the samples directory (defaults: web/ and samples/ beside the package).
NA_STATIC_DIR=
NA_SAMPLES_DIR=
