# Base image for every FROM in infrastructure/docker/Dockerfile (CONTRACT-DECISIONS item 20): the website's current pin,
# the Docker Official Image python:3.14.7-slim-trixie (CPython 3.14.7 on Debian 13), by index digest. The tag beside
# the digest is documentation; Docker resolves the digest. ci.yml fails when any FROM that is not an earlier stage
# differs from BASE_IMAGE@BASE_DIGEST, so the two cannot drift. Plain shell assignments, read by /bin/sh.
# [VERIFY] re-resolve the digest at the first image build (docker buildx imagetools inspect python:3.14.7-slim-trixie).
BASE_IMAGE=python:3.14.7-slim-trixie
BASE_DIGEST=sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d
BASE_PYTHON_VERSION=3.14.7
